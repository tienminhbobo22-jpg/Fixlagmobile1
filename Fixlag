local function createToggle(name, yPos, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -16, 0, 28)
	btn.Position = UDim2.new(0, 8, 0, yPos)
	btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
	btn.Text = name .. ": OFF"
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.Font = Enum.Font.GothamSemibold
	btn.TextSize = 10
	btn.Parent = container
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
	
	local state = false
	btn.MouseButton1Click:Connect(function()
		state = not state
		btn.BackgroundColor3 = state and Color3.fromRGB(0, 130, 90) or Color3.fromRGB(40, 40, 50)
		btn.Text = name .. (state and ": ON" or ": OFF")
		callback(state)
	end)
end

local isEffectClean = false
local isPotatoGraph = false
local isMuteSound = false

local function applyPotatoGraphics()
	pcall(function()
		Lighting.GlobalShadows = false
		Lighting.FogEnd = 9e9
		Lighting.Brightness = 1
		for _, v in ipairs(Lighting:GetDescendants()) do
			if v:IsA("Sky") or v:IsA("Atmosphere") or v:IsA("Clouds") or v:IsA("PostEffect") or v:IsA("SunRaysEffect") or v:IsA("BlurEffect") or v:IsA("BloomEffect") or v:IsA("ColorCorrectionEffect") then
				v:Destroy()
			end
		end
		Workspace.Terrain.WaterWaveSize = 0
		Workspace.Terrain.WaterWaveSpeed = 0
		Workspace.Terrain.WaterReflectance = 0
		
		for _, v in ipairs(Workspace:GetDescendants()) do
			if v:IsA("BasePart") then
				v.CastShadow = false
			end
		end
	end)
end

createToggle("POTATO GRAPHICS (FIX LAG SPIKE)", 8, function(state)
	isPotatoGraph = state
	if state then applyPotatoGraphics() end
end)

createToggle("-60% EFFECT & DỌN RÁC (SIÊU TỐC)", 42, function(state) 
	isEffectClean = state 
end)

createToggle("MUTE ÂM THANH", 76, function(state) 
	isMuteSound = state 
	SoundService.Volume = state and 0 or 1
	for _, s in ipairs(Workspace:GetDescendants()) do
		if s:IsA("Sound") then s.Volume = state and 0 or 1 end
	end
end)

math.randomseed(tick())

-- HÀM BẢO VỆ TUYỆT ĐỐI: DÒ NGƯỢC LÊN XEM CÓ DÍNH PLAYER HAY QUÁI (NPC CÓ HUMANOID) KHÔNG
local function isProtected(v)
	local current = v
	while current and current ~= Workspace and current ~= game do
		if current:FindFirstChildOfClass("Humanoid") then
			return true
		end
		for _, p in ipairs(Players:GetPlayers()) do
			if current == p.Character or current == p.Backpack then
				return true
			end
		end
		current = current.Parent
	end
	return false
end

local lingeringParts = {}

Workspace.DescendantAdded:Connect(function(v)
	pcall(function()
		if isPotatoGraph and v:IsA("BasePart") then
			v.CastShadow = false
		end

		if isProtected(v) then return end
		
		if isMuteSound and v:IsA("Sound") then
			v.Volume = 0
		end
		
		if isEffectClean then
			if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
				if math.random() <= 0.6 then
					v:Destroy()
				end
			elseif v:IsA("BasePart") and not v.Anchored then
				v.CanCollide = false
				v.CanTouch = false
				v.CanQuery = false
				lingeringParts[v] = {time = tick(), obj = v}
			end
		end
	end)
end)

RunService.Heartbeat:Connect(function()
	pcall(function()
		if isMuteSound then SoundService.Volume = 0 end
		
		if isEffectClean then
			local now = tick()
			for obj, data in pairs(lingeringParts) do
				if not obj or not obj.Parent then
					lingeringParts[obj] = nil
				else
					if (now - data.time > 0.8) then
						obj:Destroy()
						lingeringParts[obj] = nil
					end
				end
			end
		end
	end)
end)
