-- 1. XÓA EFFECT & MUTE ÂM THANH
local function wipeItem(v)
	if isCleanAll then
		if v:IsA("Sound") then
			pcall(function() v.SoundId = "" v.Volume = 0 v:Stop() end)
		elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Fire") or v:IsA("Smoke") then
			pcall(function() v:Destroy() end)
		end
	end
end

task.spawn(function()
	while task.wait(1) do
		if isCleanAll then
			SoundService.Volume = 0
			for _, v in ipairs(Workspace:GetDescendants()) do wipeItem(v) end
		end
	end
end)
Workspace.DescendantAdded:Connect(function(v) wipeItem(v) end)

