-- Kiểm tra an toàn không đụng vào nhân vật hoặc balo/vũ khí đang cầm
local function isPlayerAsset(v)
	for _, p in ipairs(Players:GetPlayers()) do
		local char = p.Character
		local bp = p.Backpack
		if (char and (v == char or v:IsDescendantOf(char))) or (bp and (v == bp or v:IsDescendantOf(bp))) then
			return true
		end
	end
	return false
end

-- HỆ THỐNG QUÉT RÁC HIỆU ỨNG TỒN ĐỌNG (SIÊU TỐC 0.8 GIÂY)
local lingeringParts = {}

Workspace.DescendantAdded:Connect(function(v)
	pcall(function()
		if isPlayerAsset(v) then return end
		
		if isMuteSound and v:IsA("Sound") then
			v.Volume = 0
		end
		
		if isHide60 then
			if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Fire") or v:IsA("Smoke") then
				if math.random() <= 0.6 then
					v:Destroy()
				end
			elseif (v:IsA("BasePart") or v:IsA("Model")) and not v:FindFirstChildOfClass("Humanoid") then
				lingeringParts[v] = {time = tick(), obj = v}
			end
		end
	end)
end)

RunService.Heartbeat:Connect(function()
	pcall(function()
		if isMuteSound then
			SoundService.Volume = 0
		end
		
		if isHide60 then
			local now = tick()
			for obj, data in pairs(lingeringParts) do
				if not obj or not obj.Parent then
					lingeringParts[obj] = nil
				else
					-- Tự động bốc hơi cực nhanh sau 0.8 giây khi skill kết thúc / kẹt lại
					if (now - data.time > 0.8) then
						obj:Destroy()
						lingeringParts[obj] = nil
					end
				end
			end
		end
	end)
end)

