local function createToggle(name, yPos, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -16, 0, 32)
	btn.Position = UDim2.new(0, 8, 0, yPos)
	btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
	btn.Text = name .. ": OFF"
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.Font = Enum.Font.GothamSemibold
	btn.TextSize = 10
	btn.Parent = container
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
	
	local state = false
	btn.MouseButton1Click:Connect(function()
		state = not state
		btn.BackgroundColor3 = state and Color3.fromRGB(0, 130, 90) or Color3.fromRGB(40, 40, 50)
		btn.Text = name .. (state and ": ON" or ": OFF")
		callback(state)
	end)
end

local safeConnection = nil

createToggle("DIỆT CÂY, KHỐI & GIỮ TRỌN TIẾNG SKILL (V97)", 8, function(state)
	if state then
		local function isProtected(v)
			if not v or not v.Parent then return true end
			if player.Character and (v == player.Character or v:IsDescendantOf(player.Character)) then
				return true
			end
			if v:IsA("Tool") or v:FindFirstAncestorOfClass("Tool") then
				return true
			end
			
			local model = v:FindFirstAncestorOfClass("Model")
			if model then
				if Players:GetPlayerFromCharacter(model) then
					return true
				end
				if model.Parent and (model.Parent.Name == "Enemies" or model.Parent.Name == "Characters" or model.Parent.Name == "NPCs") then
					return true
				end
			end
			
			local name = v.Name:lower()
			if name:find("fruit") or name:find("chest") then
				return true
			end
			return false
		end

		local function checkAndDestroy(v)
			if isProtected(v) then return end
			if v == Workspace.Terrain then return end

			if v:IsA("Model") then
				local mName = v.Name:lower()
				if mName:find("tree") or mName:find("wood") or mName:find("trunk") or mName:find("branch") or mName:find("leaf") or mName:find("leaves") or mName:find("stump") or mName:find("log") or mName:find("plant") or mName:find("bush") or mName:find("foliage") then
					v:Destroy()
				end
			elseif v:IsA("BasePart") then
				local name = v.Name:lower()
				local parentName = v.Parent and v.Parent.Name:lower() or ""
				local model = v:FindFirstAncestorOfClass("Model")
				local modelName = model and model.Name:lower() or ""
				
				local isDebris = name:find("rock") or name:find("stone") or name:find("debris") or name:find("chunk") or name:find("earth") or name:find("ground") or name:find("rubble") or name:find("shard") or parentName:find("debris") or parentName:find("rock") or parentName:find("stone")
				
				if isDebris or (not v.Anchored) then
					v:Destroy()
				end
			elseif v:IsA("Sound") then
				-- Đợi âm thanh chạy hết 4 giây mới dọn dẹp để không bị cụt tiếng giữa chừng
				task.spawn(function()
					task.wait(4)
					if v and v.Parent then
						pcall(function()
							v:Stop()
							v:Destroy()
						end)
					end
				end)
			end
		end

		pcall(function()
			for _, v in ipairs(Workspace:GetDescendants()) do
				checkAndDestroy(v)
			end
		end)

		safeConnection = Workspace.DescendantAdded:Connect(function(v)
			task.spawn(function()
				task.wait(0.1)
				if v and v.Parent then
					checkAndDestroy(v)
				end
				
				task.wait(0.9)
				if v and v.Parent and not isProtected(v) then
					if v:IsA("Beam") or v:IsA("Trail") or v:IsA("ParticleEmitter") or v:IsA("Attachment") or v:IsA("Highlight") then
						v:Destroy()
					end
				end
			end)
		end)
	else
		if safeConnection then
			safeConnection:Disconnect()
			safeConnection = nil
		end
	end
end)

createToggle("POTATO GRAPHICS (TẮT SẠCH BÓNG)", 48, function(state)
	if state then
		pcall(function()
			Lighting.GlobalShadows = false
			Lighting.FogEnd = 9e9
			Lighting.Brightness = 1
			for _, v in ipairs(Lighting:GetDescendants()) do
				if v:IsA("Sky") or v:IsA("Atmosphere") or v:IsA("Clouds") or v:IsA("PostEffect") or v:IsA("SunRaysEffect") then
					v:Destroy()
				end
			end
			Workspace.Terrain.WaterWaveSize = 0
			Workspace.Terrain.WaterWaveSpeed = 0
			
			for _, v in ipairs(Workspace:GetDescendants()) do
				if v:IsA("BasePart") then
					v.CastShadow = false
				end
			end
		end)
	end
end)
